/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=60, must-revalidate

/ashen-reach.html
  Cache-Control: public, max-age=60, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=60, must-revalidate

/
  Cache-Control: public, max-age=60, must-revalidate

/ashen-reach/startup/starter/manifest.json
  Cache-Control: no-cache

/ashen-reach/startup/character/manifest.json
  Cache-Control: no-cache

/ashen-reach/startup/starter/*.br
  Content-Type: application/octet-stream
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform

/ashen-reach/human-shape-v1/*.bin
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/human-shape-v1/manifest.json
  Cache-Control: no-cache

/ashen-reach/human-shape-v1/texture-*
  Cache-Control: public, max-age=31536000, immutable

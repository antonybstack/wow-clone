/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/index.html
  Cache-Control: public, max-age=60, must-revalidate

/ashen-reach.html
  Cache-Control: public, max-age=60, must-revalidate

# Pages canonicalizes the .html route before serving its static response.
# https://developers.cloudflare.com/pages/configuration/serving-pages/#route-matching
/ashen-reach
  Cache-Control: public, max-age=60, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.wasm
  Content-Type: application/wasm

# Keep the short cache lifetime on the unhashed legacy root binary. A splat also
# matches /assets/v2/*.wasm; Pages concatenates matching headers, which would put
# two max-age values on a content-addressed bundle asset.
# https://developers.cloudflare.com/pages/configuration/headers/
/HavokPhysics.wasm
  Cache-Control: public, max-age=60, must-revalidate

# Exact pinned WASM, compressed during build. Preserve native streaming compilation.
# https://developers.cloudflare.com/pages/configuration/headers/
/physics/*.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform

/
  Cache-Control: public, max-age=60, must-revalidate

/ashen-reach/startup/starter/manifest.json
  Cache-Control: no-cache

/ashen-reach/startup/character/manifest.json
  Cache-Control: no-cache

/ashen-reach/startup/starter/*.br
  Content-Type: application/octet-stream
  Content-Encoding: br
  Cache-Control: public, max-age=31536000, immutable, no-transform

/ashen-reach/human-shape-v1/*.bin
  Cache-Control: public, max-age=31536000, immutable

# Authored rigid props use content-addressed URLs shared by all supported fits.
# https://developers.cloudflare.com/pages/configuration/headers/
/ashen-reach/props/*.glb
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/human-shape-v1/manifest.json
  Cache-Control: no-cache

/ashen-reach/human-shape-v1/texture-*
  Cache-Control: public, max-age=31536000, immutable

# Revalidate the mutable index when content-addressed identity packs rotate.
# https://developers.cloudflare.com/pages/configuration/headers/
/ashen-reach/human-identity-v1/manifest.json
  Cache-Control: no-cache

/ashen-reach/human-identity-v1/manifest-*.json
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/human-identity-v1/*.bin
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/human-identity-v1/texture-*
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/region-actors-v1/*.glb
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/region-actors-v1/*.bin
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/region-actors-v1/46c726f07044d09f00aaf64d7e3e0347b3b4c5c641703d1f08ff993c326de05a.json
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/region-actors-v1/85ed96fa3ff713bda0531d9fe4c4d40fa7dab45ed860e9d864a631e321a124be.json
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/region-actors-v1/manifest.json
  Cache-Control: no-cache

/ashen-reach/presence-v1/collision-*
  Cache-Control: public, max-age=31536000, immutable

/ashen-reach/presence-v1/manifest.json
  Cache-Control: no-cache

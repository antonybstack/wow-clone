{
  "name": "lite-moonwell",
  "version": "1.0.0",
  "private": true,
  "description": "Babylon Lite demo that loads the Blender moonwell shrine",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "trees": "node scripts/plant-trees.mjs && node scripts/export-glb.mjs",
    "export": "node scripts/export-glb.mjs",
    "export:safe": "node scripts/export-glb.mjs --strip-transmission",
    "save": "node scripts/save-blend.mjs",
    "status": "node scripts/status.mjs",
    "shot": "node scripts/shot.mjs"
  },
  "dependencies": {
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/lite": "^1.28.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}

#!/usr/bin/env bash
# The `tg` helper AGENTS.md and docs/debug-view.md have always referred to. It was
# documented but never committed, so the delivery step it names could not actually be
# run -- which is how a visual cycle got closed with stills only.
#
# Credentials come from the environment (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) and are
# never echoed, never written to a file, and never passed on a visible command line.
#
#   tg file <path> [caption]   send a video/animation/photo/document, type chosen by extension
#   tg text <message>          send a plain message
#   tg record <path>           log an already-sent file against the current commit
#
# Put this on PATH, or invoke as `bash scripts/tg ...` from the repo.
set -euo pipefail

: "${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN is not set}"
: "${TELEGRAM_CHAT_ID:?TELEGRAM_CHAT_ID is not set}"
api="https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}"

# Fail loudly on Telegram's own errors. `curl -f` will not do this: the API answers
# 200 with {"ok":false,...} for a rejected upload, so a silent no-op would otherwise
# look like a successful delivery -- exactly the failure this helper exists to prevent.
# Every successful send is recorded against the commit that was HEAD at the time.
# That ledger is what .claude/hooks/telegram-motion-stop.py measures "is there
# undelivered visual work?" against -- without it the gate can only see the working
# tree, and goes blind the moment the work is committed.
ledger() {
  local root sha
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  sha=$(git rev-parse HEAD 2>/dev/null || echo unknown)
  mkdir -p "$root/.claude"
  printf '%s %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sha" "${1:-message}" \
    >> "$root/.claude/telegram-deliveries.log"
}

check() {
  local body="$1"
  if printf '%s' "$body" | grep -q '"ok":true'; then
    ledger "${2:-message}"
    printf '%s\n' "$body" | sed -E 's/.*"message_id":([0-9]+).*/sent, message_id \1/' | head -1
  else
    printf 'telegram rejected the send: %s\n' "$body" >&2
    exit 1
  fi
}

cmd="${1:-}"; shift || true
case "$cmd" in
  file)
    path="${1:?usage: tg file <path> [caption]}"; shift || true
    caption="${*:-}"
    [ -f "$path" ] || { echo "no such file: $path" >&2; exit 1; }
    # tr, not ${path,,}: macOS ships bash 3.2 and would fail to parse that.
    ext=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
    case "$ext" in
      *.mp4|*.mov|*.webm) method=sendVideo;     field=video     ;;
      *.gif)              method=sendAnimation; field=animation ;;
      *.png|*.jpg|*.jpeg) method=sendPhoto;     field=photo     ;;
      *)                  method=sendDocument;  field=document  ;;
    esac
    # Videos go with supports_streaming so Telegram plays them inline instead of
    # offering a download; a clip nobody presses play on is not a reviewed clip.
    check "$(curl -sS --max-time 900 "${api}/${method}" \
      -F "chat_id=${TELEGRAM_CHAT_ID}" \
      -F "${field}=@${path}" \
      -F "caption=${caption}" \
      -F "supports_streaming=true")" "$path"
    ;;
  record)
    # Record a delivery that already happened. The clip is usually sent *before* the
    # commit that finishes the work, so the ledger line would otherwise point at the
    # parent commit and the Stop hook would flag already-delivered work as pending.
    # Re-run this after committing rather than re-uploading the file.
    ledger "${1:?usage: tg record <path>}"
    echo "recorded delivery of $1 at $(git rev-parse --short HEAD)"
    ;;
  text)
    [ $# -gt 0 ] || { echo "usage: tg text <message>" >&2; exit 1; }
    check "$(curl -sS --max-time 60 "${api}/sendMessage" \
      -F "chat_id=${TELEGRAM_CHAT_ID}" -F "text=$*")"
    ;;
  *)
    echo "usage: tg file <path> [caption] | tg text <message> | tg record <path>" >&2; exit 1 ;;
esac
